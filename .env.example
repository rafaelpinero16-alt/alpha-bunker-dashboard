# =====================================================================
#  ALPHA BUNKER DASHBOARD — VARIABLES DE ENTORNO
#  Copia este archivo como `.env` y completa los valores reales.
# =====================================================================

# ---------------------------------------------------------------------
# TELEGRAM BOT
# ---------------------------------------------------------------------
# Token emitido por @BotFather (formato 123456789:AA...)
BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# Dominio HTTPS público donde corre este backend (Railway, Render, ngrok).
# Sin barra final. Ej: https://alpha-bunker.up.railway.app
WEBHOOK_HOST=https://your-public-domain.example.com

# Ruta del webhook de Telegram dentro de esta API.
WEBHOOK_PATH=/api/v1/telegram/webhook

# Secreto que Telegram enviará en el header X-Telegram-Bot-Api-Secret-Token.
# Solo A-Z, a-z, 0-9, guion y guion bajo (1-256 caracteres).
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
WEBHOOK_SECRET=change_me_to_a_long_random_secret_token

# URL pública del Dashboard / Mini App. Si el frontend se sirve desde este
# mismo backend, usa el mismo dominio que WEBHOOK_HOST (con barra final).
DASHBOARD_URL=https://your-public-domain.example.com/

# ID numérico del administrador principal (notificaciones de pagos y alertas).
# Obténlo escribiendo a @userinfobot.
ADMIN_TELEGRAM_ID=123456789

# (Opcional) ID del grupo/canal VIP al que se entregan enlaces de invitación
# de un solo uso tras cada pago. El bot debe ser administrador allí.
VIP_CHAT_ID=-1001234567890

# Equivalencia Telegram Stars por cada 1 USD del plan (ajústala a tu precio).
STARS_PER_USD=77

# Validez máxima (segundos) del initData de la Mini App.
INIT_DATA_MAX_AGE=86400

# ---------------------------------------------------------------------
# SERVIDOR
# ---------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Archivo de persistencia JSON (se crea automáticamente).
DATABASE_PATH=data/alpha_bunker.json

# ---------------------------------------------------------------------
# PAYPAL (REST API v2)
# ---------------------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_MODE=sandbox
# ID del webhook creado en developer.paypal.com (necesario para verificar firmas).
PAYPAL_WEBHOOK_ID=

# ---------------------------------------------------------------------
# BINANCE PAY (Merchant API)
# ---------------------------------------------------------------------
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---------------------------------------------------------------------
# PAGOS MANUALES (opcionales, se muestran como instrucciones en el checkout)
# ---------------------------------------------------------------------
GLOBAL66_ACCOUNT=
PAYONEER_EMAIL=
