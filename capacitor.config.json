{
  "appId": "com.alphabunker.app",
  "appName": "Alpha Bunker",
  "webDir": "www",
  "loggingBehavior": "debug",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https",
    "hostname": "localhost"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "backgroundColor": "#050505"
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#050505",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchAutoHide": true,
      "backgroundColor": "#050505",
      "showSpinner": false
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    }
  }
}
